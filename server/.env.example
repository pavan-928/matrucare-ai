# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- MongoDB ----------
# Local:  mongodb://127.0.0.1:27017/matrucare-hackathon
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/matrucare-hackathon?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/matrucare-hackathon

# Any long random text
JWT_SECRET=replace_with_a_long_random_secret

# ---------- Email (Gmail) ----------
# Use a Gmail account you own and can sign in to. EMAIL_USER must match the
# Gmail account that created the App Password. The display name remains MatruCare AI.
# EMAIL_PASS is the 16-character Google App Password (NOT your normal password).
# Leave EMAIL_PASS empty while testing: OTPs are printed in the backend terminal.
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=

# ---------- Frontend URL (for CORS) ----------
CLIENT_URL=http://localhost:5173
